{
  "description": "GeoCrop Engine recipe exported as an openEO process graph; see docs/openeo.md for differences from local processing.",
  "id": "geocrop_s1_composite_spring_ASC",
  "process_graph": {
    "apply1": {
      "arguments": {
        "data": {
          "from_node": "resamplespatial1"
        },
        "process": {
          "process_graph": {
            "gt1": {
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": 0
              },
              "process_id": "gt"
            },
            "if1": {
              "arguments": {
                "accept": {
                  "from_parameter": "x"
                },
                "value": {
                  "from_node": "gt1"
                }
              },
              "process_id": "if",
              "result": true
            }
          }
        }
      },
      "process_id": "apply"
    },
    "loadcollection1": {
      "arguments": {
        "bands": [
          "VV",
          "VH"
        ],
        "id": "SENTINEL1_GRD",
        "properties": {
          "sat:orbit_state": {
            "process_graph": {
              "eq1": {
                "arguments": {
                  "x": {
                    "from_parameter": "value"
                  },
                  "y": "ascending"
                },
                "process_id": "eq",
                "result": true
              }
            }
          }
        },
        "spatial_extent": {
          "crs": 32634,
          "east": 500100.0,
          "north": 5000080.0,
          "south": 4999980.0,
          "west": 499980.0
        },
        "temporal_extent": [
          "2023-04-01",
          "2023-05-01"
        ]
      },
      "process_id": "load_collection"
    },
    "reducedimension1": {
      "arguments": {
        "data": {
          "from_node": "apply1"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "mean1": {
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "ignore_nodata": true
              },
              "process_id": "mean",
              "result": true
            }
          }
        }
      },
      "process_id": "reduce_dimension"
    },
    "resamplespatial1": {
      "arguments": {
        "align": "upper-left",
        "data": {
          "from_node": "sarbackscatter1"
        },
        "method": "bilinear",
        "projection": 32634,
        "resolution": 10.0
      },
      "process_id": "resample_spatial"
    },
    "sarbackscatter1": {
      "arguments": {
        "coefficient": "sigma0-ellipsoid",
        "contributing_area": false,
        "data": {
          "from_node": "loadcollection1"
        },
        "elevation_model": null,
        "ellipsoid_incidence_angle": false,
        "local_incidence_angle": false,
        "mask": false,
        "noise_removal": true,
        "options": {}
      },
      "process_id": "sar_backscatter"
    },
    "saveresult1": {
      "arguments": {
        "data": {
          "from_node": "reducedimension1"
        },
        "format": "GTiff",
        "options": {}
      },
      "process_id": "save_result",
      "result": true
    }
  },
  "summary": "Sentinel-1 mean backscatter composite (sigma0-ellipsoid), window spring"
}
